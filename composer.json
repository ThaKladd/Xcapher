{
    "name": "xcapher/xcapher",
    "description": "Escape, cast, validate and sanitize any PHP value through one small fluent API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "escape",
        "escaper",
        "sanitizer",
        "validator",
        "cast",
        "xss",
        "sql"
    ],
    "authors": [
        {
            "name": "John Larsen",
            "email": "johninen@gmail.com",
            "homepage": "https://betweenmovies.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ThaKladd/Xcapher",
    "support": {
        "issues": "https://github.com/ThaKladd/Xcapher/issues",
        "source": "https://github.com/ThaKladd/Xcapher"
    },
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-intl": "Better transliteration in slug()",
        "ext-mysqli": "Escaping and quoting for mysqli connections",
        "ext-pgsql": "Escaping and quoting for PgSql connections",
        "ext-pdo": "Escaping and quoting for PDO connections"
    },
    "autoload": {
        "psr-4": {
            "Xcapher\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Xcapher\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=build/coverage --coverage-clover=build/coverage.xml",
        "mutation": "infection --min-msi=90 --min-covered-msi=90 --show-mutations=0",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "test:coverage": "Run the tests with code coverage (needs pcov or Xdebug); HTML report in build/coverage",
        "mutation": "Run Infection mutation testing (needs pcov or Xdebug)",
        "analyse": "Run PHPStan static analysis",
        "lint": "Check coding standards without changing files",
        "fix": "Fix coding standard violations",
        "check": "Run lint, static analysis and tests"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.3"
    }
}
